<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AndroidAdbFs</AssemblyName>
    <WinFspDir Condition="'$(WinFspDir)' == ''">C:\Program Files (x86)\WinFsp</WinFspDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\LICENSE" LogicalName="AndroidAdbFs.LICENSE" />
    <EmbeddedResource Include="..\third_party\WinFsp-License.txt" LogicalName="AndroidAdbFs.WinFspLicense" />
    <EmbeddedResource Include="..\vendor\winfsp-2.1.25156.msi" LogicalName="AndroidAdbFs.WinFspInstaller" />
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspDir)\bin\winfsp-msil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
